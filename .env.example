# Copy to .env. The app can run without installing a local inference runtime.
MOSS_APP_HOST=127.0.0.1
MOSS_APP_PORT=8000

# Legacy defaults for notes created before per-job devices were introduced.
# New jobs use the target selected in the app's device manager.
MOSS_TRANSCRIPTION_BACKEND=mlx
MOSS_TRANSCRIPTION_URL=http://127.0.0.1:8001/v1
# Optional bearer token for the transcription server; never sent to the UI.
MOSS_TRANSCRIPTION_API_KEY=
# Optional: true enables the included server's NDJSON progress/cancellation.
# Remote mode defaults to false. Generic SSE streaming is not supported.
# MOSS_TRANSCRIPTION_STREAM=true

# Local MLX server and the built-in "This Mac" device use this port.
MOSS_MLX_PORT=8001
MOSS_MODEL_NAME=moss-mtd

# Add remote devices through the app: SSH host, GPU UUID, worker port/model.
# The global URL below is retained only for old notes without device snapshots.
# The older MOSS_MLX_URL setting remains a fallback if the new URL is absent.

# Defaults: .venv for the web app, .venv-mlx for MLX, models/moss-mlx-8bit
# for weights, and .cache/ for package and model download caches in this repo.
# Optional path overrides (relative paths start from this repo):
# MLX_VENV=.venv-mlx
# MLX_MODEL_PATH=models/moss-mlx-8bit
MLX_MODEL_ID=vanch007/mlx-MOSS-Transcribe-Diarize-8bit
MLX_MAX_TOKENS=32768
# Quantize the KV cache separately from model weights. Set 0 to disable.
MLX_KV_BITS=8
# Bound temporary attention memory during long-audio prefill.
MLX_PREFILL_STEP_SIZE=512

# Default chunk length; each new note can override it in the upload form.
MOSS_CHUNK_SECONDS=1800
# Overlap used to recognize speakers across chunk boundaries.
MOSS_BRIDGE_SECONDS=30
MOSS_MAX_COMPLETION_TOKENS=32768
MOSS_MAX_UPLOAD_GB=5

# Optional app-level HTTP Basic authentication. Use only behind HTTPS.
MOSS_AUTH_USERNAME=
MOSS_AUTH_PASSWORD=
